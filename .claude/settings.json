{
  "permissions": {
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Read(*/.ssh/*)",
      "Read(*.ssh/*)",
      "Bash(*cat*id_rsa*)",
      "Bash(*cat*.pem)",
      "Bash(*cat*credentials*)",
      "Bash(*type*id_rsa*)",
      "Bash(*type*.pem)",
      "Bash(*type*credentials*)",
      "Bash(*Get-Content*id_rsa*)",
      "Bash(*Get-Content*.pem*)",
      "Bash(*Get-Content*credentials*)",
      "Bash(*sed*id_rsa*)",
      "Bash(*sed*.pem*)",
      "Bash(*sed*credentials*)"
    ],
    "allow": [
      "Read(documentation/**)",
      "Read(**/documentation/**)",
      "Read(generated-docs/**)",
      "Read(**/generated-docs/**)",
      "Write(generated-docs/**)",
      "Write(**/generated-docs/**)",
      "Edit(generated-docs/**)",
      "Edit(**/generated-docs/**)",
      "Read(web/**)",
      "Read(**/web/**)",
      "Glob(web/**)",
      "Glob(**/web/**)",
      "Glob(documentation/**)",
      "Glob(**/documentation/**)",
      "Glob(generated-docs/**)",
      "Glob(**/generated-docs/**)",
      "Glob(.claude/**)",
      "Glob(**/.claude/**)",
      "Write(web/**)",
      "Write(**/web/**)",
      "Edit(web/**)",
      "Edit(**/web/**)",
      "Bash(npx playwright test*)",
      "Bash(npx playwright install*)",
      "Bash(npx playwright --version)",
      "Bash(npm run test:e2e*)",
      "Bash(npm --prefix web test*)",
      "Bash(npm --prefix web run test:quality*)",
      "Bash(npm --prefix web run test:e2e*)",
      "Bash(npx vitest*)",
      "Bash(node .claude/scripts/*.js*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \".claude/hooks/workflow-guard.ps1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \".claude/hooks/inject-phase-context.ps1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "developer|test-generator|feature-planner|design-api-agent|design-style-agent|intake-agent|api-connectivity-agent|playwright-runner|code-review-runner|mock-setup-agent|type-generator-agent",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \".claude/hooks/inject-agent-context.ps1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \".claude/hooks/bash-permission-checker.js\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \".claude/hooks/enforce-generated-doc-names.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
